# Public values. Local defaults are printed by `npm run db:start`.
# Replace them with the selected Supabase project values in deployed environments.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix this value with NEXT_PUBLIC_. Add it only when an approved
# server workflow needs to bypass RLS; the current application clients do not use it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
